extends baseEmail
block settings
  - const preheader = 'Confirm your email address to activate your CustomForge account.'
  - const eyebrow = 'ACCOUNT / VERIFICATION'
  - const heading = 'One step closer. Verify your email.'
  - const actionLabel = 'Verify my email'
block content
  +paragraph('Hi ' + firstName + ',')
  +paragraph('Confirm that this email address belongs to you to finish setting up your CustomForge account.')
  +notice('Keep your account secure', 'Use your latest verification email. If the link has expired, request a new one from CustomForge. If you did not request this email, you can ignore it.')

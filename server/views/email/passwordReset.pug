extends baseEmail
block settings
  - const preheader = 'Use this link within 10 minutes to reset your CustomForge password.'
  - const eyebrow = 'ACCOUNT / SECURITY'
  - const heading = 'Reset your password. Get back in.'
  - const actionLabel = 'Reset my password'
block content
  +paragraph('Hi ' + firstName + ',')
  +paragraph('We received a request to reset your CustomForge password. Choose a new password using the secure link below.')
  +notice('This link expires in 10 minutes', 'The link can be used once. If you did not request a reset, ignore this email; your password will stay unchanged.')

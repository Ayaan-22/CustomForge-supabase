extends baseEmail
block settings
  - const preheader = verifyEmail ? 'One more step: verify your email to activate your CustomForge account.' : 'Welcome to CustomForge. Discover the gear for your next setup.'
  - const eyebrow = 'PLAYER ONE / WELCOME'
  - const heading = 'Your next level starts here.'
  - const actionLabel = verifyEmail ? 'Verify my email' : 'Explore the store'
block content
  +paragraph('Welcome, ' + firstName + '.')
  +paragraph('Make room for your next upgrade. Explore gaming hardware, discover your next build, and find gear that fits the way you play.')
  if verifyEmail
    +notice('Activate your account', 'Verify your email address to finish setting up your account. If you did not create this account, you can ignore this message.')
  else
    +notice('Your setup. Your play style.', 'Explore the catalog and manage your orders from your CustomForge account.')

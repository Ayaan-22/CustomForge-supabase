extends baseEmail
block settings
  - const preheader = 'Your CustomForge order #' + shortOrderId + ' has been cancelled.'
  - const eyebrow = 'ORDER / CANCELLED'
  - const heading = 'Your order is cancelled.'
  - const actionLabel = 'View my order'
block content
  +paragraph('Hi ' + firstName + ', your order has been cancelled.')
  +orderReference
  +notice('Cancellation confirmed', 'This email confirms cancellation only. It does not confirm a refund. Check your order for any payment updates.')
  +paragraph('When you are ready for your next upgrade, CustomForge is here.')

mixin paragraph(text)
  p(style="margin:0 0 18px;font-size:16px;line-height:26px;color:#cbd5e1;")= text

mixin notice(title, text)
  table(role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:6px 0 24px;")
    tr
      td(bgcolor="#1c2238" style="border-left:3px solid #a78bfa;padding:18px 20px;")
        p(style="margin:0 0 6px;font-size:14px;line-height:21px;color:#f8fafc;font-weight:bold;")= title
        p(style="margin:0;font-size:14px;line-height:23px;color:#cbd5e1;")= text

mixin action(label, href)
  table.action-table(role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;")
    tr
      td(align="center" bgcolor="#b8a1ff" style="border:1px solid #b8a1ff;border-radius:6px;mso-padding-alt:16px 28px;")
        a(href=href style="display:block;padding:16px 28px;border-radius:6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:22px;font-weight:bold;color:#101426 !important;text-decoration:none;text-align:center;")= label

mixin orderReference
  p(style="margin:0 0 6px;font-family:'Courier New',monospace;font-size:11px;letter-spacing:1px;line-height:18px;color:#a9b7cd;") ORDER REFERENCE
  p(style="margin:0 0 24px;font-family:'Courier New',monospace;font-size:13px;line-height:21px;color:#e2e8f0;word-break:break-all;")= orderId

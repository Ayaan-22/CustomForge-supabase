extends baseEmail
block settings
  - const preheader = 'Your return request for CustomForge order #' + shortOrderId + ' is awaiting review.'
  - const eyebrow = 'ORDER / RETURN REQUEST'
  - const heading = 'Return request received.'
  - const actionLabel = 'View return status'
block content
  +paragraph('Hi ' + firstName + ', we have received your return request.')
  +orderReference
  +notice('Awaiting review', 'Your request has not yet been approved. This email does not confirm a refund. Check your order for updates and any next steps.')
  +paragraph('Please wait for return instructions before sending any items back.')

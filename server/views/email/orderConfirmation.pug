extends baseEmail
block settings
  - const preheader = 'Order #' + shortOrderId + ' received. Total: ' + total + ' USD. ' + paymentStatus + '.'
  - const eyebrow = 'LOADOUT / ORDER RECEIVED'
  - const heading = 'Order received. Gear up.'
  - const actionLabel = 'View my order'
block content
  +paragraph('Hi ' + firstName + ', thanks for choosing CustomForge.')
  +paragraph(paymentNote)
  +orderReference
  if items.length
    table.items-table(width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;table-layout:fixed;")
      caption(style="text-align:left;font-size:16px;font-weight:bold;color:#f8fafc;padding:0 0 12px;") Your gear
      thead
        tr
          th(scope="col" width="52%" align="left" style="padding:10px 0;border-bottom:1px solid #394058;color:#a9b7cd;font-size:11px;line-height:18px;") ITEM
          th(scope="col" width="14%" align="center" style="padding:10px 0;border-bottom:1px solid #394058;color:#a9b7cd;font-size:11px;line-height:18px;") QTY
          th(scope="col" width="34%" align="right" style="padding:10px 0;border-bottom:1px solid #394058;color:#a9b7cd;font-size:11px;line-height:18px;") UNIT PRICE
      tbody
        each item in items
          tr
            td(style="padding:14px 10px 14px 0;border-bottom:1px solid #30364d;color:#e2e8f0;font-size:14px;line-height:22px;overflow-wrap:anywhere;word-break:break-word;")= item.name
            td(align="center" style="padding:14px 0;border-bottom:1px solid #30364d;color:#cbd5e1;font-size:14px;line-height:22px;")= item.quantity
            td(align="right" style="padding:14px 0;border-bottom:1px solid #30364d;color:#e2e8f0;font-size:14px;line-height:22px;")= item.unitPrice
  table.totals-table(role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#1c2238" style="margin:0 0 24px;")
    each row in totals
      tr
        td(style="padding:10px 18px;color:#cbd5e1;font-size:14px;line-height:20px;")= row.label
        td(align="right" style="padding:10px 18px;color:#e2e8f0;font-size:14px;line-height:20px;")= row.value
    tr
      td(style="padding:18px;border-top:1px solid #394058;color:#ffffff;font-size:16px;line-height:24px;font-weight:bold;") Total (USD)
      td(align="right" style="padding:18px;border-top:1px solid #394058;color:#c4b5fd;font-size:22px;line-height:28px;font-weight:bold;")= total
  +notice(paymentStatus, paymentLabel + '. For the latest payment and fulfillment status, open your order.')
